From: kschen <admin@kschen.eu.org>
Date: Fri, 31 Jul 2026 23:40:00 +0800
Subject: [PATCH 2/2] arm64: dts: qcom: capricorn: add TD4722 panel variant

Some Xiaomi Mi 5s units are fitted with an LGD TD4722 instead of the JDI
R63452.  The panel cannot be probed before the DSI host is up, so add a
second DTB that selects the TD4722 compatible and boot whichever one
matches the hardware.

While here, fix three things in the board DT:

 - The Synaptics attention line is edge triggered on this board; with
   IRQ_TYPE_LEVEL_LOW the RMI4 interrupt never fires.  Verified working
   with EDGE_FALLING (input reports "Synaptics TD4722A7", IRQ 125 counts
   up normally).

 - hsusb_phy1 was missing vdd-supply, which qcom,qusb2-phy.yaml lists as
   required.  Without it the PHY never claims the 0.925V digital rail and
   at boot the PLL fails to lock:

     qcom-qusb2-phy 7411000.phy: supply vdd not found, using dummy regulator
     phy phy-7411000.phy.4: QUSB2PHY pll lock failed: status reg = 0
     dwc3 6a00000.usb: error -EBUSY: failed to initialize core

   leaving the machine with no USB at all, neither host nor gadget.
   Binding dwc3 by hand from userspace always succeeds, because by then
   the DSI, PCIe and UFS PHYs have enabled l28 for their own use -
   regulator_summary shows 7411000.phy referencing l12 and l24, but not
   l28.  Describe the supply so the PHY does not depend on an unrelated
   consumer winning the race.

 - The WLED needs a non-default configuration for this panel.  Use the
   mainline qcom-wled property names; the downstream QPNP names are not
   parsed by drivers/video/backlight/qcom-wled.c and would be silently
   ignored.  Also describe the OVP interrupt (IRQ 0 of peripheral 0xd8 on
   PMI8994 WLED3), otherwise probe logs "IRQ ovp not found" and
   over-voltage events go unreported.

Signed-off-by: kschen <admin@kschen.eu.org>
---
 arch/arm64/boot/dts/qcom/Makefile                  |  1 +
 .../dts/qcom/msm8996pro-xiaomi-capricorn-td4722.dts | 11 +++++++
 .../boot/dts/qcom/msm8996pro-xiaomi-capricorn.dts  | 22 +++++++++++++-
 3 files changed, 33 insertions(+), 1 deletion(-)
 create mode 100644 arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-capricorn-td4722.dts

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -113,6 +113,7 @@ dtb-$(CONFIG_ARCH_QCOM)	+= msm8996-zte-axon7.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= msm8996pro-oneplus3t-s6e3fa3.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= msm8996pro-oneplus3t-s6e3fa5.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= msm8996pro-xiaomi-capricorn.dtb
+dtb-$(CONFIG_ARCH_QCOM)	+= msm8996pro-xiaomi-capricorn-td4722.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= msm8996pro-xiaomi-natrium.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= msm8996pro-xiaomi-scorpio.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= msm8998-asus-novago-tp370ql.dtb
diff --git a/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-capricorn-td4722.dts b/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-capricorn-td4722.dts
new file mode 100644
index 0000000..65e955e
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-capricorn-td4722.dts
@@ -0,0 +1,11 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Xiaomi Mi 5s variants fitted with the LGD TD4722 DSI panel.
+ *
+ * The regular capricorn DTB selects the JDI R63452 panel. The panel cannot
+ * be detected before the DSI host is initialized, so boot the DTB matching
+ * the panel fitted to the device.
+ */
+
+#define CAPRICORN_TD4722_PANEL
+#include "msm8996pro-xiaomi-capricorn.dts"
diff --git a/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-capricorn.dts b/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-capricorn.dts
--- a/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-capricorn.dts
+++ b/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-capricorn.dts
@@ -22,7 +22,7 @@
 		compatible = "syna,rmi4-i2c";
 		reg = <0x20>;
 		interrupt-parent = <&tlmm>;
-		interrupts = <125 IRQ_TYPE_LEVEL_LOW>;
+		interrupts = <125 IRQ_TYPE_EDGE_FALLING>;
 		vdd-supply = <&vdd_3v2_tp>;
 		syna,reset-delay-ms = <200>;
 		syna,startup-delay-ms = <5>;
@@ -42,6 +42,10 @@
 	monitored-battery = <&battery>;
 };
 
+&hsusb_phy1 {
+	vdd-supply = <&vreg_l28a_0p925>;
+};
+
 &mdss_dsi0 {
 	status = "okay";
 
@@ -54,7 +58,11 @@
 	pinctrl-1 = <&mdss_dsi_sleep &mdss_te_sleep>;
 
 	panel: panel@0 {
+#ifdef CAPRICORN_TD4722_PANEL
+		compatible = "lgd,td4722";
+#else
 		compatible = "jdi,fhd-r63452";
+#endif
 		reg = <0>;
 		reset-gpios = <&tlmm 8 GPIO_ACTIVE_LOW>;
 		backlight = <&pmi8994_wled>;
@@ -73,6 +81,15 @@
 
 &pmi8994_wled {
 	status = "okay";
+
+	interrupts = <0x3 0xd8 0x0 IRQ_TYPE_EDGE_RISING>,
+		     <0x3 0xd8 0x2 IRQ_TYPE_EDGE_RISING>;
+	interrupt-names = "ovp", "short";
+
+	qcom,current-boost-limit = <980>;
+	qcom,current-limit-microamp = <20000>;
+	qcom,ovp-millivolt = <29500>;
+	qcom,switching-freq = <600>;
 };
 
 &mss_pil {
