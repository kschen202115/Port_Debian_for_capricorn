From: kschen <admin@kschen.eu.org>
Date: Tue, 5 Aug 2026 22:45:00 +0800
Subject: [PATCH 7/8] arm64: dts: qcom: msm8996pro-xiaomi-capricorn: add rear
 camera IMX378 and its VCM

后摄是 Sony IMX378，挂在 CCI master 0 / CSIPHY0 上，对焦马达是 AKM AK7371。

已在硬件上验证：两者都能 probe，pipeline 能出帧，focus_absolute 扫 0..4095
时实测图像锐度随之单调变化。

接线来自下游 boot.img 的 DTB (qcom,camera@0) 加上实机验证：
  MCLK0    = TLMM gpio 13 @ 24 MHz
  reset    = TLMM gpio 30
  cam_vana = ldoa17 -> vreg_l17a_2p8  (2.8 V) -> VANA
  cam_vdig = vdd_cam_1p1              (1.1 V) -> VDIG
  cam_vio  = vsa1   -> vreg_lvs1a_1p8 (1.8 V) -> VDDL
  cam_vaf  = ldoa23 -> vreg_l23a_2p8  (2.8 V) -> VCM vdd

**注意 gpio 86 不是传感器复位脚**，尽管下游设备树把它标成 CAM_RESET0。
它是 msm8996-xiaomi-common.dtsi 里 vdd_cam_1p1 那个 regulator-fixed 的
使能脚（1.3V 进 1.1V 出的负载开关）。照下游标签把它写成 reset-gpios 的
结果是 pinctrl 抢不到该引脚：

  imx378 3-0010: Error applying setting, reverse things back
  i2c-qcom-cci a0c000.cci: master 0 queue 1 timeout

真正的复位是 gpio 30，也就是下游标成 CAM_STANDBY0 的那个，
和 msm8996pro-xiaomi-scorpio.dts 里 imx318 的写法一致。

i2c 地址、lane 数、链路速率来自反汇编厂商 HAL blob libmmcamera_imx378.so
的 sensor_slave_info 与寄存器初始化表：
  slave_addr       0x20 (8-bit)     -> 7-bit 0x10
  reg 0x0114       0x03             -> 4 data lanes (6 个模式全一致)
  reg 0x0113       0x0a             -> RAW10
  reg 0x0820-0823  4800 Mbps 总带宽 -> 1200 Mbps/lane -> link 600 MHz

上电后在 CCI 总线上实扫，0x10 返回 chip id 0x0378，0x50 是标定 EEPROM。

对焦马达型号来自厂商 blob libactuator_ak7371_a7_{liteon,semco}.so。
AK7371 和 in-tree ak7375 驱动支持的 AK7375 寄存器兼容（12 位位置值放在
0x00/0x01，standby 在 0x02），所以直接用 asahi-kasei,ak7375 即可。

需要 CONFIG_VIDEO_IMX378=m 与 CONFIG_VIDEO_AK7375=m。

Signed-off-by: kschen <admin@kschen.eu.org>
---
diff --git a/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-capricorn.dts b/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-capricorn.dts
index e75e114..ffe47ea 100644
--- a/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-capricorn.dts
+++ b/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-capricorn.dts
@@ -127,6 +127,16 @@
 	vdda-supply = <&vreg_l2a_1p25>;
 
 	ports {
+		/* CSIPHY0 <- rear camera */
+		port@0 {
+			reg = <0>;
+			csiphy0_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&imx378_ep>;
+			};
+		};
+
 		/* CSIPHY2 <- front camera */
 		port@2 {
 			reg = <2>;
@@ -143,6 +153,70 @@
 	status = "okay";
 };
 
+&cci_i2c0 {
+	status = "okay";
+	clock-frequency = <400000>;
+
+	/*
+	 * Rear camera VCM.  The vendor blob is libactuator_ak7371_*.so, and
+	 * the AK7371 is register compatible with the AK7375 the in-tree
+	 * driver already handles (12-bit position at 0x00/0x01, standby at
+	 * 0x02).  Verified on the hardware: focus_absolute sweeps 0..4095
+	 * and the measured image sharpness follows the position.
+	 */
+	ak7375: camera-lens@c {
+		compatible = "asahi-kasei,ak7375";
+		reg = <0x0c>;
+
+		vdd-supply = <&vreg_l23a_2p8>;		/* downstream cam_vaf 2.8 V */
+		vio-supply = <&vreg_lvs1a_1p8>;
+	};
+
+	/*
+	 * Rear camera - Sony IMX378.
+	 * i2c address, lane count and link rate confirmed by disassembling
+	 * the vendor HAL blob libmmcamera_imx378.so:
+	 *   slave_addr       0x20 (8-bit) -> 0x10
+	 *   reg 0x0114       0x03 -> 4 data lanes
+	 *   reg 0x0113       0x0a -> RAW10
+	 *   reg 0x0820-0823  4800 Mbps total -> 600 MHz link frequency
+	 *
+	 * Note gpio 86 is NOT the sensor reset despite what the downstream
+	 * device tree labels it - it is the enable for the vdd_cam_1p1 load
+	 * switch.  The reset is gpio 30, which downstream calls CAM_STANDBY0.
+	 */
+	imx378: camera-sensor@10 {
+		compatible = "sony,imx378";
+		reg = <0x10>;
+
+		clocks = <&mmcc CAMSS_MCLK0_CLK>;
+		assigned-clocks = <&mmcc CAMSS_MCLK0_CLK>;
+		assigned-clock-rates = <24000000>;
+
+		VANA-supply = <&vreg_l17a_2p8>;		/* 2.8 V analog */
+		VDIG-supply = <&vdd_cam_1p1>;		/* 1.1 V digital core */
+		VDDL-supply = <&vreg_lvs1a_1p8>;	/* 1.8 V interface */
+
+		reset-gpios = <&tlmm 30 GPIO_ACTIVE_HIGH>;
+
+		lens-focus = <&ak7375>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam0_default>;
+
+		rotation = <90>;
+		orientation = <1>;			/* back */
+
+		port {
+			imx378_ep: endpoint {
+				data-lanes = <0 1 2 3>;
+				link-frequencies = /bits/ 64 <600000000>;
+				remote-endpoint = <&csiphy0_ep>;
+			};
+		};
+	};
+};
+
 &cci_i2c1 {
 	clock-frequency = <1000000>;
 
@@ -428,6 +502,22 @@
 		"RFFE1_DATA",		/* GPIO_148 */
 		"RFFE1_CLK";		/* GPIO_149 */
 
+	cam0_default: cam0-default-state {
+		mclk-pins {
+			pins = "gpio13";
+			function = "cam_mclk";
+			drive-strength = <16>;
+			bias-disable;
+		};
+
+		rst-pins {
+			pins = "gpio30";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+	};
+
 	cam2_default: cam2-default-state {
 		mclk-pins {
 			pins = "gpio15";
-- 
2.34.1

