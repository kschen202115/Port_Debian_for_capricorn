+/* Chip ID */
+#define IMX378_REG_CHIP_ID		CCI_REG16(0x0016)
+#define IMX378_CHIP_ID			0x0378
+
+#define IMX378_REG_MODE_SELECT		CCI_REG8(0x0100)
+#define IMX378_MODE_STANDBY		0x00
+#define IMX378_MODE_STREAMING		0x01
+
+#define IMX378_REG_ORIENTATION		CCI_REG8(0x101)
+
+#define IMX378_REG_CSI_DT_FMT_H		CCI_REG8(0x0112)
+#define IMX378_REG_CSI_DT_FMT_L		CCI_REG8(0x0113)
+
+#define IMX378_XCLK_FREQ		24000000
+
+#define IMX378_DEFAULT_LINK_FREQ	450000000
+
+/*
+ * Pixel rate = vt_pix_clk * 4.  With the stock PLL_VT_MPY of 350 that is
+ * 24MHz / 4 (prepll) * 350 / 2 (vtsysck) / 5 (vtpxck) * 4 = 840MHz.
+ * The 4-lane IMX378 configuration uses PLL_VT_MPY = 200 instead, giving
+ * 480MHz - which matches 4056x3040 at 30fps.
+ */
