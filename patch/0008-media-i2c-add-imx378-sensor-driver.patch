+  #define IMX378_IOP_SYSCK_DIV_4LANE	0x01
+#define IMX378_REG_IOP_PREDIV		CCI_REG8(0x030d)
+  #define IMX378_IOP_PREDIV		0x02
+#define IMX378_REG_IOP_MPY		CCI_REG16(0x030e)
+
+/* Test Pattern Control */
+#define IMX378_REG_TEST_PATTERN		CCI_REG16(0x0600)
+#define IMX378_TEST_PATTERN_DISABLE	0
+#define IMX378_TEST_PATTERN_SOLID_COLOR	1
+#define IMX378_TEST_PATTERN_COLOR_BARS	2
+#define IMX378_TEST_PATTERN_GREY_COLOR	3
+#define IMX378_TEST_PATTERN_PN9		4
