+// SPDX-License-Identifier: GPL-2.0
+/*
+ * A V4L2 driver for Sony IMX378 cameras.
+ * Copyright (C) 2020, Raspberry Pi (Trading) Ltd
+ *
+ * Based on Sony imx219 camera driver
+ * Copyright (C) 2019-2020 Raspberry Pi (Trading) Ltd
+ *
+ * Derived from the Raspberry Pi imx477 driver, which already handled the
+ * IMX378 as a variant.  Trimmed down to IMX378 only and extended with
+ * 4-lane support for the Xiaomi Mi 5s (capricorn) rear camera.
+ */
+#include <linux/unaligned.h>
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of_device.h>
+#include <linux/pm_runtime.h>
