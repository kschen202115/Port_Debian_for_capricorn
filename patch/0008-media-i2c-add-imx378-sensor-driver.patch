+#include <media/v4l2-device.h>
+#include <media/v4l2-event.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-mediabus.h>
+
+/*
+ * The Raspberry Pi tree exposes the sensor's embedded-data pad with a
+ * downstream-only media bus code.  Mainline has no equivalent; define it
+ * locally so the metadata pad keeps working - nothing in the mainline
+ * pipeline consumes it.
+ */
+#ifndef MEDIA_BUS_FMT_SENSOR_DATA
+#define MEDIA_BUS_FMT_SENSOR_DATA	0x7002
+#endif
+
+static int dpc_enable = 1;
+module_param(dpc_enable, int, 0644);
+MODULE_PARM_DESC(dpc_enable, "Enable on-sensor DPC");
+
+/*
+ * Bring-up escape hatches for the 4-lane configuration.
+ *
+ * The driver derives PLL_OP_MPY from the DT link-frequency, which for the
+ * 600MHz link used by the Xiaomi Mi 5s works out at 100.  The vendor
+ * firmware for the same module instead programs 350 with an OP system
+ * clock divider of 1.  The two do not reconcile, and only hardware can say
+ * which one the sensor actually wants, so allow both to be overridden at
+ * runtime.  Values <= 0 mean "leave the driver's own choice alone".
+ *
+ * These are applied after the mode register list on every stream start, so
+ * they can be changed via sysfs between attempts without reloading:
+ *
+ *   echo 350 > /sys/module/imx378/parameters/iop_mpy_override
+ */
+static int iop_mpy_override;
+module_param(iop_mpy_override, int, 0644);
+MODULE_PARM_DESC(iop_mpy_override,
+		 "4-lane only: force PLL_OP_MPY (0x030e). 0 = driver-computed, 350 = vendor value");
+
+static int iop_sysck_override;
+module_param(iop_sysck_override, int, 0644);
+MODULE_PARM_DESC(iop_sysck_override,
+		 "4-lane only: force IOP_SYSCK_DIV (0x030b). 0 = driver default (1 for 4 lanes)");
+
+static int trigger_mode;
+module_param(trigger_mode, int, 0644);
+MODULE_PARM_DESC(trigger_mode, "Set vsync trigger mode: 1=source, 2=sink");
+
+static int fstrobe_enable;
+module_param(fstrobe_enable, int, 0644);
+MODULE_PARM_DESC(fstrobe_enable, "Enable fstrobe signal");
+
+static int fstrobe_cont_trig;
+module_param(fstrobe_cont_trig, int, 0644);
+MODULE_PARM_DESC(fstrobe_cont_trig, "Configure fstrobe to be one-shot (0) or continuous (1)");
+
+static int fstrobe_width = 1;
+module_param(fstrobe_width, int, 0644);
+MODULE_PARM_DESC(fstrobe_width, "Set fstrobe pulse width in units of INCK");
+
+static int fstrobe_delay;
+module_param(fstrobe_delay, int, 0644);
+MODULE_PARM_DESC(fstrobe_delay, "Set fstrobe delay from end all lines starting to expose and the start of the strobe pulse");
+
+#define IMX378_REG_VALUE_08BIT		1
+#define IMX378_REG_VALUE_16BIT		2
