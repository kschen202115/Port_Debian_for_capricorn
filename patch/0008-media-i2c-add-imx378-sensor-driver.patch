+
+#define IMX378_REG_IOP_PXCK_DIV		CCI_REG8(0x0309)
+#define IMX378_REG_IOP_SYSCK_DIV	CCI_REG8(0x030b)
+  #define IMX378_IOP_SYSCK_DIV		0x02
