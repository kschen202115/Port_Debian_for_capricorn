+#define IMX378_REG_FRAME_LENGTH		CCI_REG16(0x0340)
+#define IMX378_VBLANK_MIN		48
+#define IMX378_FRAME_LENGTH_MAX		0xffdc
+
+/* H_TIMING internal */
+#define IMX378_REG_LINE_LENGTH		CCI_REG16(0x0342)
+#define IMX378_LINE_LENGTH_MAX		0xfff0
