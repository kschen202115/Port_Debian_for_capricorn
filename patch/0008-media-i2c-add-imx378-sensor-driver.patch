+#define IMX378_EXPOSURE_STEP		1
+#define IMX378_EXPOSURE_DEFAULT		0x640
+#define IMX378_EXPOSURE_MAX		(IMX378_FRAME_LENGTH_MAX - \
+					 IMX378_EXPOSURE_OFFSET)
+
