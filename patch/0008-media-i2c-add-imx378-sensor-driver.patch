+
+/* Embedded metadata stream structure */
+#define IMX378_EMBEDDED_LINE_WIDTH 16384
+#define IMX378_NUM_EMBEDDED_LINES 1
+
+enum pad_types {
+	IMAGE_PAD,
+	METADATA_PAD,
+	NUM_PADS
+};
+
+/* IMX378 native and active pixel array size. */
+#define IMX378_NATIVE_WIDTH		4072U
+#define IMX378_NATIVE_HEIGHT		3176U
+#define IMX378_PIXEL_ARRAY_LEFT		8U
+#define IMX378_PIXEL_ARRAY_TOP		16U
+#define IMX378_PIXEL_ARRAY_WIDTH	4056U
+#define IMX378_PIXEL_ARRAY_HEIGHT	3040U
+
+struct imx378_reg_list {
+	unsigned int num_of_regs;
+	const struct cci_reg_sequence *regs;
+};
+
+/* Mode : resolution and related config&values */
+struct imx378_mode {
+	/* Frame width */
+	unsigned int width;
+
+	/* Frame height */
+	unsigned int height;
+
+	/* Analog crop rectangle. */
+	struct v4l2_rect crop;
+
+	/* Default frame_length value to use in this mode */
+	unsigned int frm_length_default;
+
+	/* Default register values */
+	struct imx378_reg_list reg_list;
+};
+
