+static inline struct imx378 *to_imx378(struct v4l2_subdev *_sd)
+{
+	return container_of(_sd, struct imx378, sd);
+}
+
+/* Get bayer order based on flip setting. */
+static u32 imx378_get_format_code(struct imx378 *imx378, u32 code)
+{
+	unsigned int i;
+
+	lockdep_assert_held(&imx378->mutex);
+
+	for (i = 0; i < ARRAY_SIZE(codes); i++)
+		if (codes[i] == code)
+			break;
+
+	if (i >= ARRAY_SIZE(codes))
+		i = 0;
+
+	i = (i & ~3) | (imx378->vflip->val ? 2 : 0) |
+	    (imx378->hflip->val ? 1 : 0);
+
+	return codes[i];
+}
+
+static void imx378_set_default_format(struct imx378 *imx378)
+{
+	/* Set default mode to max resolution */
+	imx378->mode = &supported_modes[0];
+	imx378->fmt_code = MEDIA_BUS_FMT_SRGGB12_1X12;
+}
+
+static int imx378_get_bpp(unsigned int code)
+{
+	switch (code) {
+	default:
+	case MEDIA_BUS_FMT_SRGGB12_1X12:
+	case MEDIA_BUS_FMT_SGRBG12_1X12:
+	case MEDIA_BUS_FMT_SGBRG12_1X12:
+	case MEDIA_BUS_FMT_SBGGR12_1X12:
+		return 12;
+
+	case MEDIA_BUS_FMT_SRGGB10_1X10:
+	case MEDIA_BUS_FMT_SGRBG10_1X10:
+	case MEDIA_BUS_FMT_SGBRG10_1X10:
+	case MEDIA_BUS_FMT_SBGGR10_1X10:
+		return 10;
+
+	case MEDIA_BUS_FMT_SRGGB8_1X8:
+	case MEDIA_BUS_FMT_SGRBG8_1X8:
+	case MEDIA_BUS_FMT_SGBRG8_1X8:
+	case MEDIA_BUS_FMT_SBGGR8_1X8:
+		return 8;
+	}
+}
+
+static int imx378_open(struct v4l2_subdev *sd, struct v4l2_subdev_fh *fh)
+{
+	struct imx378 *imx378 = to_imx378(sd);
+	struct v4l2_mbus_framefmt *try_fmt_img =
+		v4l2_subdev_state_get_format(fh->state, IMAGE_PAD);
+	struct v4l2_mbus_framefmt *try_fmt_meta =
+		v4l2_subdev_state_get_format(fh->state, METADATA_PAD);
+	struct v4l2_rect *try_crop;
+
+	mutex_lock(&imx378->mutex);
+
+	/* Initialize try_fmt for the image pad */
+	try_fmt_img->width = supported_modes[0].width;
+	try_fmt_img->height = supported_modes[0].height;
+	try_fmt_img->code = imx378_get_format_code(imx378,
+						   MEDIA_BUS_FMT_SRGGB12_1X12);
+	try_fmt_img->field = V4L2_FIELD_NONE;
+
+	/* Initialize try_fmt for the embedded metadata pad */
+	try_fmt_meta->width = IMX378_EMBEDDED_LINE_WIDTH;
+	try_fmt_meta->height = IMX378_NUM_EMBEDDED_LINES;
+	try_fmt_meta->code = MEDIA_BUS_FMT_SENSOR_DATA;
+	try_fmt_meta->field = V4L2_FIELD_NONE;
+
+	/* Initialize try_crop */
+	try_crop = v4l2_subdev_state_get_crop(fh->state, IMAGE_PAD);
+	try_crop->left = IMX378_PIXEL_ARRAY_LEFT;
+	try_crop->top = IMX378_PIXEL_ARRAY_TOP;
+	try_crop->width = IMX378_PIXEL_ARRAY_WIDTH;
+	try_crop->height = IMX378_PIXEL_ARRAY_HEIGHT;
+
+	mutex_unlock(&imx378->mutex);
+
+	return 0;
+}
+
+static void imx378_adjust_exposure_range(struct imx378 *imx378)
+{
+	int exposure_max, exposure_def;
+
+	/* Honour the VBLANK limits when setting exposure. */
+	exposure_max = imx378->mode->height + imx378->vblank->val -
+		       IMX378_EXPOSURE_OFFSET;
+	exposure_def = min(exposure_max, imx378->exposure->val);
+	__v4l2_ctrl_modify_range(imx378->exposure, imx378->exposure->minimum,
+				 exposure_max, imx378->exposure->step,
+				 exposure_def);
+}
+
+static int imx378_set_frame_length(struct imx378 *imx378, unsigned int val)
+{
+	int ret = 0;
+
+	imx378->long_exp_shift = 0;
+
+	while (val > IMX378_FRAME_LENGTH_MAX) {
+		imx378->long_exp_shift++;
+		val >>= 1;
+	}
+
+	ret = cci_write(imx378->regmap, IMX378_REG_FRAME_LENGTH, val, NULL);
+
+	return cci_write(imx378->regmap, IMX378_LONG_EXP_SHIFT_REG,
+			 imx378->long_exp_shift, &ret);
+}
+
+static int imx378_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct imx378 *imx378 =
+		container_of(ctrl->handler, struct imx378, ctrl_handler);
+	struct i2c_client *client = v4l2_get_subdevdata(&imx378->sd);
+	int ret = 0;
+
+	/*
+	 * The VBLANK control may change the limits of usable exposure, so check
+	 * and adjust if necessary.
+	 */
+	if (ctrl->id == V4L2_CID_VBLANK)
+		imx378_adjust_exposure_range(imx378);
+
+	/*
+	 * Applying V4L2 control value only happens
+	 * when power is up for streaming
+	 */
+	if (pm_runtime_get_if_in_use(&client->dev) == 0)
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(imx378->regmap, IMX378_REG_ANALOG_GAIN,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(imx378->regmap, IMX378_REG_EXPOSURE,
+				ctrl->val >> imx378->long_exp_shift, NULL);
+		break;
+	case V4L2_CID_DIGITAL_GAIN:
+		ret = cci_write(imx378->regmap, IMX378_REG_DIGITAL_GAIN,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		ret = cci_write(imx378->regmap, IMX378_REG_TEST_PATTERN,
+				imx378_test_pattern_val[ctrl->val], NULL);
+		break;
+	case V4L2_CID_TEST_PATTERN_RED:
+		ret = cci_write(imx378->regmap, IMX378_REG_TEST_PATTERN_R,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_TEST_PATTERN_GREENR:
+		ret = cci_write(imx378->regmap, IMX378_REG_TEST_PATTERN_GR,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_TEST_PATTERN_BLUE:
+		ret = cci_write(imx378->regmap, IMX378_REG_TEST_PATTERN_B,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_TEST_PATTERN_GREENB:
+		ret = cci_write(imx378->regmap, IMX378_REG_TEST_PATTERN_GB,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		ret = cci_write(imx378->regmap, IMX378_REG_ORIENTATION,
+				imx378->hflip->val | imx378->vflip->val << 1,
+				NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = imx378_set_frame_length(imx378,
+					      imx378->mode->height + ctrl->val);
+		break;
+	case V4L2_CID_HBLANK:
+		ret = cci_write(imx378->regmap, IMX378_REG_LINE_LENGTH,
+				imx378->mode->width + ctrl->val, NULL);
+		break;
+	default:
+		dev_info(&client->dev,
+			 "ctrl(id:0x%x,val:0x%x) is not handled\n",
+			 ctrl->id, ctrl->val);
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_mark_last_busy(&client->dev);
+	pm_runtime_put_autosuspend(&client->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops imx378_ctrl_ops = {
+	.s_ctrl = imx378_set_ctrl,
+};
+
+static int imx378_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	struct imx378 *imx378 = to_imx378(sd);
+
+	if (code->pad >= NUM_PADS)
+		return -EINVAL;
+
+	if (code->pad == IMAGE_PAD) {
+		if (code->index >= (ARRAY_SIZE(codes) / 4))
+			return -EINVAL;
+
+		mutex_lock(&imx378->mutex);
+		code->code = imx378_get_format_code(imx378,
+						    codes[code->index * 4]);
+		mutex_unlock(&imx378->mutex);
+	} else {
+		if (code->index > 0)
+			return -EINVAL;
+
+		code->code = MEDIA_BUS_FMT_SENSOR_DATA;
+	}
+
+	return 0;
+}
+
+static int imx378_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct imx378 *imx378 = to_imx378(sd);
+	u32 code;
+
+	if (fse->pad >= NUM_PADS)
+		return -EINVAL;
+
+	if (fse->pad == IMAGE_PAD) {
+		if (fse->index >= ARRAY_SIZE(supported_modes))
+			return -EINVAL;
+
+		mutex_lock(&imx378->mutex);
+		code = imx378_get_format_code(imx378, fse->code);
+		mutex_unlock(&imx378->mutex);
+
+		if (fse->code != code)
+			return -EINVAL;
+
+		fse->min_width = supported_modes[fse->index].width;
+		fse->max_width = fse->min_width;
+		fse->min_height = supported_modes[fse->index].height;
+		fse->max_height = fse->min_height;
+	} else {
+		if (fse->code != MEDIA_BUS_FMT_SENSOR_DATA || fse->index > 0)
+			return -EINVAL;
+
+		fse->min_width = IMX378_EMBEDDED_LINE_WIDTH;
+		fse->max_width = fse->min_width;
+		fse->min_height = IMX378_NUM_EMBEDDED_LINES;
+		fse->max_height = fse->min_height;
+	}
+
+	return 0;
+}
+
+static void imx378_reset_colorspace(struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_MAP_YCBCR_ENC_DEFAULT(fmt->colorspace);
+	fmt->quantization = V4L2_MAP_QUANTIZATION_DEFAULT(true,
+							  fmt->colorspace,
+							  fmt->ycbcr_enc);
+	fmt->xfer_func = V4L2_MAP_XFER_FUNC_DEFAULT(fmt->colorspace);
+}
+
+static void imx378_update_image_pad_format(struct imx378 *imx378,
+					   const struct imx378_mode *mode,
+					   struct v4l2_subdev_format *fmt)
+{
+	fmt->format.width = mode->width;
+	fmt->format.height = mode->height;
+	fmt->format.field = V4L2_FIELD_NONE;
+	imx378_reset_colorspace(&fmt->format);
+}
+
+static void imx378_update_metadata_pad_format(struct v4l2_subdev_format *fmt)
+{
+	fmt->format.width = IMX378_EMBEDDED_LINE_WIDTH;
+	fmt->format.height = IMX378_NUM_EMBEDDED_LINES;
+	fmt->format.code = MEDIA_BUS_FMT_SENSOR_DATA;
+	fmt->format.field = V4L2_FIELD_NONE;
+}
+
+static int imx378_get_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct imx378 *imx378 = to_imx378(sd);
+
+	if (fmt->pad >= NUM_PADS)
+		return -EINVAL;
+
+	mutex_lock(&imx378->mutex);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+		struct v4l2_mbus_framefmt *try_fmt =
+			v4l2_subdev_state_get_format(sd_state,
+						   fmt->pad);
+		/* update the code which could change due to vflip or hflip: */
+		try_fmt->code = fmt->pad == IMAGE_PAD ?
+				imx378_get_format_code(imx378, try_fmt->code) :
+				MEDIA_BUS_FMT_SENSOR_DATA;
+		fmt->format = *try_fmt;
+	} else {
+		if (fmt->pad == IMAGE_PAD) {
+			imx378_update_image_pad_format(imx378, imx378->mode,
+						       fmt);
+			fmt->format.code =
+			       imx378_get_format_code(imx378, imx378->fmt_code);
+		} else {
+			imx378_update_metadata_pad_format(fmt);
+		}
+	}
+
+	mutex_unlock(&imx378->mutex);
+	return 0;
+}
+
+static void imx378_set_framing_limits(struct imx378 *imx378)
+{
+	unsigned int hblank_min;
+	u64 line_length_min;
+	int bpp;
+	const struct imx378_mode *mode = imx378->mode;
+
+	/* Default to no long exposure multiplier. */
+	imx378->long_exp_shift = 0;
+
+	/* Update limits and set FPS to default */
+	__v4l2_ctrl_modify_range(imx378->vblank,
+				 IMX378_VBLANK_MIN,
+				 ((1 << IMX378_LONG_EXP_SHIFT_MAX) *
+					IMX378_FRAME_LENGTH_MAX) - mode->height,
+				 1, mode->frm_length_default - mode->height);
+
+	/* Setting this will adjust the exposure limits as well. */
+	__v4l2_ctrl_s_ctrl(imx378->vblank,
+			   mode->frm_length_default - mode->height);
+
+	bpp = imx378_get_bpp(imx378->fmt_code);
+
+	line_length_min = mode->width * bpp * (u64)imx378->pixel_rate_value;
+	do_div(line_length_min,
+	       imx378->link_freq_value * 2 * imx378->nlanes);
+	/* Allow 500pixel clocks for HS<>LP transitions (approx 0.6usecs) */
+	line_length_min += 500;
+
+	/*
+	 * 1332x990 12bit mode appears to need additional horizontal blanking
+	 * compared to all other modes. Empirically determined setting with
+	 * link freq of 750MHz where it still gives valid images. The limit
+	 * leaves all other modes unchanged as their line times are inherently
+	 * greater.
+	 */
+	if (bpp == 12)
+		line_length_min = max(line_length_min, 1332 + 4600);
+
+	hblank_min = line_length_min - mode->width;
+	__v4l2_ctrl_modify_range(imx378->hblank, hblank_min,
+				 IMX378_LINE_LENGTH_MAX, 1, hblank_min);
+	__v4l2_ctrl_s_ctrl(imx378->hblank, hblank_min);
+}
+
+static int imx378_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct v4l2_mbus_framefmt *framefmt;
+	const struct imx378_mode *mode;
+	struct imx378 *imx378 = to_imx378(sd);
+
+	if (fmt->pad >= NUM_PADS)
+		return -EINVAL;
+
+	mutex_lock(&imx378->mutex);
+
+	if (fmt->pad == IMAGE_PAD) {
+		/* Bayer order varies with flips */
+		fmt->format.code = imx378_get_format_code(imx378,
+							  fmt->format.code);
+
+		mode = v4l2_find_nearest_size(supported_modes,
+					      ARRAY_SIZE(supported_modes),
+					      width, height,
+					      fmt->format.width,
+					      fmt->format.height);
+		imx378_update_image_pad_format(imx378, mode, fmt);
+		if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+			framefmt = v4l2_subdev_state_get_format(sd_state,
+							      fmt->pad);
+			*framefmt = fmt->format;
+		} else if (imx378->mode != mode ||
+			   imx378->fmt_code != fmt->format.code) {
+			imx378->mode = mode;
+			imx378->fmt_code = fmt->format.code;
+			imx378_set_framing_limits(imx378);
+		}
+	} else {
+		if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+			framefmt = v4l2_subdev_state_get_format(sd_state,
+							      fmt->pad);
+			*framefmt = fmt->format;
+		} else {
+			/* Only one embedded data mode is supported */
+			imx378_update_metadata_pad_format(fmt);
+		}
+	}
+
+	mutex_unlock(&imx378->mutex);
+
+	return 0;
+}
+
+static const struct v4l2_rect *
+__imx378_get_pad_crop(struct imx378 *imx378,
+		      struct v4l2_subdev_state *sd_state,
+		      unsigned int pad, enum v4l2_subdev_format_whence which)
+{
+	switch (which) {
+	case V4L2_SUBDEV_FORMAT_TRY:
+		return v4l2_subdev_state_get_crop(sd_state, pad);
+	case V4L2_SUBDEV_FORMAT_ACTIVE:
+		return &imx378->mode->crop;
+	}
+
+	return NULL;
+}
+
+static int imx378_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *sd_state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP: {
+		struct imx378 *imx378 = to_imx378(sd);
+
+		mutex_lock(&imx378->mutex);
+		sel->r = *__imx378_get_pad_crop(imx378, sd_state, sel->pad,
+						sel->which);
+		mutex_unlock(&imx378->mutex);
+
+		return 0;
+	}
+
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = IMX378_NATIVE_WIDTH;
+		sel->r.height = IMX378_NATIVE_HEIGHT;
+
+		return 0;
+
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = IMX378_PIXEL_ARRAY_LEFT;
+		sel->r.top = IMX378_PIXEL_ARRAY_TOP;
+		sel->r.width = IMX378_PIXEL_ARRAY_WIDTH;
+		sel->r.height = IMX378_PIXEL_ARRAY_HEIGHT;
+
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+/* Start streaming */
+static int imx378_start_streaming(struct imx378 *imx378)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&imx378->sd);
+	const struct imx378_reg_list *reg_list;
+	const struct imx378_reg_list *extra_regs;
+	unsigned int fst_width;
+	unsigned int fst_mult;
+	int ret, tm, bpp;
+
+	if (!imx378->common_regs_written) {
+		ret = cci_multi_reg_write(imx378->regmap, mode_common_regs,
+					  ARRAY_SIZE(mode_common_regs), NULL);
+
+		extra_regs = &imx378->compatible_data->extra_regs;
+		cci_multi_reg_write(imx378->regmap, extra_regs->regs,
+				    extra_regs->num_of_regs, &ret);
+
+		/* Update the link frequency PLL multiplier register */
+		cci_write(imx378->regmap, IMX378_REG_IOP_MPY,
+			  imx378->iop_pll_mpy, &ret);
+
+		/* mode_common_regs assumes the 2-lane divider, override it */
+		cci_write(imx378->regmap, IMX378_REG_IOP_SYSCK_DIV,
+			  imx378->iop_sysck_div, &ret);
+
+		/*
+		 * Bit rate = link freq * 2 for DDR * number of lanes.
+		 * 16p16 fixed point in the register. Ignore fractional part.
+		 */
+		cci_write(imx378->regmap, IMX378_REG_REQ_LINK_BIT_RATE,
+			  (((unsigned long)imx378->link_freq_value / 1000000) *
+			   2 * imx378->nlanes) << 16,
+			  &ret);
+		/*
+		 * DPHY timings are those specified for 450MHz. Switch to auto
+		 * if using some other link frequency
+		 */
+		if (imx378->link_freq_value != 450000000UL)
+			cci_write(imx378->regmap, IMX378_REG_DPHY_CTRL,
+				  IMX378_DPHY_CTRL_AUTO, &ret);
+
+		if (ret) {
+			dev_err(&client->dev, "%s failed to set common settings\n",
+				__func__);
+			return ret;
+		}
+		imx378->common_regs_written = true;
+	}
+
+	/* Apply default values of current mode */
+	reg_list = &imx378->mode->reg_list;
+	ret = cci_multi_reg_write(imx378->regmap, reg_list->regs,
+				  reg_list->num_of_regs, NULL);
+	if (ret) {
+		dev_err(&client->dev, "%s failed to set mode\n", __func__);
+		return ret;
+	}
+
+	if (imx378->nlanes == 4) {
+		ret = cci_multi_reg_write(imx378->regmap, imx378_4lane_regs,
+					  ARRAY_SIZE(imx378_4lane_regs), NULL);
+
+		/* Bring-up overrides, see the module parameters above */
+		if (iop_mpy_override > 0)
+			cci_write(imx378->regmap, IMX378_REG_IOP_MPY,
+				  iop_mpy_override, &ret);
+		if (iop_sysck_override > 0)
+			cci_write(imx378->regmap, IMX378_REG_IOP_SYSCK_DIV,
+				  iop_sysck_override, &ret);
+
+		if (ret) {
+			dev_err(&client->dev,
+				"%s failed to apply 4-lane overrides\n",
+				__func__);
+			return ret;
+		}
+	}
+
+	fst_width = max((unsigned int)fstrobe_width, 1U);
+	fst_mult = 1;
+
+	while (fst_width / fst_mult > 0xffff && fst_mult < 255)
+		fst_mult++;
+
+	fst_width /= fst_mult;
+
+	// FLASH_MD_RS
+	cci_write(imx378->regmap, CCI_REG8(0x0c1A),
+		  ((!!fstrobe_cont_trig) | (1 << 1)), &ret);
+	// FLASH_STRB_WIDTH
+	cci_write(imx378->regmap, CCI_REG16(0x0c18), fst_width, &ret);
+	// FLASH_STRB_WIDTH adjust
+	cci_write(imx378->regmap, CCI_REG8(0x0c12), fst_mult, &ret);
+	// FLASH_STRB_START_POINT
+	cci_write(imx378->regmap, CCI_REG16(0x0c14), fstrobe_delay, &ret);
+	// FLASH_STRB_DLY_RS
+	cci_write(imx378->regmap, CCI_REG8(0x0c16), 0, &ret);
+	// FLASH_TRIG_RS
+	cci_write(imx378->regmap, CCI_REG8(0x0c1B), !!fstrobe_enable, &ret);
+
+	bpp = imx378_get_bpp(imx378->fmt_code);
+	cci_write(imx378->regmap, IMX378_REG_CSI_DT_FMT_H, bpp, &ret);
+	cci_write(imx378->regmap, IMX378_REG_CSI_DT_FMT_L, bpp, &ret);
+	cci_write(imx378->regmap, IMX378_REG_IOP_PXCK_DIV, bpp, &ret);
+	cci_write(imx378->regmap, IMX378_REG_ADBIT_MODE, bpp == 12 ? 1 : 0,
+		  &ret);
+
+	/* Set on-sensor DPC. */
+	cci_write(imx378->regmap, CCI_REG8(0x0b05), !!dpc_enable, &ret);
+	cci_write(imx378->regmap, CCI_REG8(0x0b06), !!dpc_enable, &ret);
+
+	/* Apply customized values from user */
+	ret =  __v4l2_ctrl_handler_setup(imx378->sd.ctrl_handler);
+	if (ret)
+		return ret;
+
+	/* Set vsync trigger mode: 0=standalone, 1=source, 2=sink */
+	tm = (imx378->trigger_mode_of >= 0) ? imx378->trigger_mode_of : trigger_mode;
+	if (tm == 1)
+		cci_write(imx378->regmap, IMX378_REG_TEMP_SEN_CTL, 0, &ret);
+	cci_write(imx378->regmap, IMX378_REG_EXTOUT_EN, (tm == 1) ? 1 : 0,
+		  &ret);
+	cci_write(imx378->regmap, IMX378_REG_MS_SEL, (tm <= 1) ? 1 : 0, &ret);
+	cci_write(imx378->regmap, IMX378_REG_XVS_IO_CTRL, (tm == 1) ? 1 : 0,
+		  &ret);
+	cci_write(imx378->regmap, IMX378_REG_MC_MODE, (tm > 0) ? 1 : 0, &ret);
+
+	/* set stream on register */
+	cci_write(imx378->regmap, IMX378_REG_MODE_SELECT,
+		  IMX378_MODE_STREAMING, &ret);
+
+	/* now it's safe to re-enable temp sensor without glitching XVS */
+	if (tm == 1)
+		cci_write(imx378->regmap, IMX378_REG_TEMP_SEN_CTL, 1, &ret);
+
+	return ret;
+}
+
+/* Stop streaming */
+static void imx378_stop_streaming(struct imx378 *imx378)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&imx378->sd);
+	int ret;
+
+	/* set stream off register */
+	ret = cci_write(imx378->regmap, IMX378_REG_MODE_SELECT,
+			IMX378_MODE_STANDBY, NULL);
+	if (ret)
+		dev_err(&client->dev, "%s failed to set stream\n", __func__);
+
+	/* Stop driving XVS out (there is still a weak pull-up) */
+	cci_write(imx378->regmap, IMX378_REG_EXTOUT_EN, 0, NULL);
+}
+
+static int imx378_set_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct imx378 *imx378 = to_imx378(sd);
+	struct i2c_client *client = v4l2_get_subdevdata(sd);
+	int ret = 0;
+
+	mutex_lock(&imx378->mutex);
+	if (imx378->streaming == enable) {
+		mutex_unlock(&imx378->mutex);
+		return 0;
+	}
+
+	if (enable) {
+		ret = pm_runtime_resume_and_get(&client->dev);
+		if (ret < 0)
+			goto err_unlock;
+
+		/*
+		 * Apply default & customized values
+		 * and then start streaming.
+		 */
+		ret = imx378_start_streaming(imx378);
+		if (ret) {
+			pm_runtime_put_sync(&client->dev);
+			goto err_unlock;
+		}
+	} else {
+		imx378_stop_streaming(imx378);
+		pm_runtime_mark_last_busy(&client->dev);
+		pm_runtime_put_autosuspend(&client->dev);
+	}
+
+	imx378->streaming = enable;
+
+	/* vflip and hflip cannot change during streaming */
+	__v4l2_ctrl_grab(imx378->vflip, enable);
+	__v4l2_ctrl_grab(imx378->hflip, enable);
+
+	mutex_unlock(&imx378->mutex);
+
+	return ret;
+
+err_unlock:
+	mutex_unlock(&imx378->mutex);
+
+	return ret;
+}
+
+/* Power/clock management functions */
+static int imx378_power_on(struct device *dev)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx378 *imx378 = to_imx378(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(IMX378_NUM_SUPPLIES,
+				    imx378->supplies);
+	if (ret) {
+		dev_err(&client->dev, "%s: failed to enable regulators\n",
+			__func__);
+		return ret;
+	}
+
+	ret = clk_prepare_enable(imx378->xclk);
+	if (ret) {
+		dev_err(&client->dev, "%s: failed to enable clock\n",
+			__func__);
+		goto reg_off;
+	}
+
+	gpiod_set_value_cansleep(imx378->reset_gpio, 1);
+	usleep_range(IMX378_XCLR_MIN_DELAY_US,
+		     IMX378_XCLR_MIN_DELAY_US + IMX378_XCLR_DELAY_RANGE_US);
+
+	return 0;
+
+reg_off:
+	regulator_bulk_disable(IMX378_NUM_SUPPLIES, imx378->supplies);
+	return ret;
+}
+
+static int imx378_power_off(struct device *dev)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx378 *imx378 = to_imx378(sd);
+
+	gpiod_set_value_cansleep(imx378->reset_gpio, 0);
+	regulator_bulk_disable(IMX378_NUM_SUPPLIES, imx378->supplies);
+	clk_disable_unprepare(imx378->xclk);
+
+	/* Force reprogramming of the common registers when powered up again. */
+	imx378->common_regs_written = false;
+
+	return 0;
+}
+
+static int __maybe_unused imx378_suspend(struct device *dev)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx378 *imx378 = to_imx378(sd);
+
+	if (imx378->streaming)
+		imx378_stop_streaming(imx378);
+
+	return 0;
+}
+
+static int __maybe_unused imx378_resume(struct device *dev)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx378 *imx378 = to_imx378(sd);
+	int ret;
+
+	if (imx378->streaming) {
+		ret = imx378_start_streaming(imx378);
+		if (ret)
+			goto error;
+	}
+
+	return 0;
+
+error:
+	imx378_stop_streaming(imx378);
+	imx378->streaming = 0;
+	return ret;
+}
+
+static int imx378_get_regulators(struct imx378 *imx378)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&imx378->sd);
+	unsigned int i;
+
+	for (i = 0; i < IMX378_NUM_SUPPLIES; i++)
+		imx378->supplies[i].supply = imx378_supply_name[i];
+
+	return devm_regulator_bulk_get(&client->dev,
+				       IMX378_NUM_SUPPLIES,
+				       imx378->supplies);
+}
+
+/* Verify chip ID */
+static int imx378_identify_module(struct imx378 *imx378, u32 expected_id)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&imx378->sd);
+	int ret;
+	u64 val;
+
+	ret = cci_read(imx378->regmap, IMX378_REG_CHIP_ID, &val, NULL);
+	if (ret) {
+		dev_err(&client->dev, "failed to read chip id %x, with error %d\n",
+			expected_id, ret);
+		return ret;
+	}
+
+	if (val != expected_id) {
+		dev_err(&client->dev, "chip id mismatch: %x!=%llx\n",
+			expected_id, val);
+		return -EIO;
+	}
+
+	dev_info(&client->dev, "Device found is imx%llx\n", val);
+
+	return 0;
+}
+
+static const struct v4l2_subdev_core_ops imx378_core_ops = {
+	.subscribe_event = v4l2_ctrl_subdev_subscribe_event,
+	.unsubscribe_event = v4l2_event_subdev_unsubscribe,
+};
+
+static const struct v4l2_subdev_video_ops imx378_video_ops = {
+	.s_stream = imx378_set_stream,
+};
+
+static const struct v4l2_subdev_pad_ops imx378_pad_ops = {
+	.enum_mbus_code = imx378_enum_mbus_code,
+	.get_fmt = imx378_get_pad_format,
+	.set_fmt = imx378_set_pad_format,
+	.get_selection = imx378_get_selection,
+	.enum_frame_size = imx378_enum_frame_size,
+};
+
+static const struct v4l2_subdev_ops imx378_subdev_ops = {
+	.core = &imx378_core_ops,
+	.video = &imx378_video_ops,
+	.pad = &imx378_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops imx378_internal_ops = {
+	.open = imx378_open,
+};
+
+/* Initialize control handlers */
+static int imx378_init_controls(struct imx378 *imx378)
+{
+	struct v4l2_ctrl_handler *ctrl_hdlr;
+	struct i2c_client *client = v4l2_get_subdevdata(&imx378->sd);
+	struct v4l2_fwnode_device_properties props;
+	unsigned int i;
+	int ret;
+
+	ctrl_hdlr = &imx378->ctrl_handler;
+	ret = v4l2_ctrl_handler_init(ctrl_hdlr, 16);
+	if (ret)
+		return ret;
+
+	mutex_init(&imx378->mutex);
+	ctrl_hdlr->lock = &imx378->mutex;
+
+	/* By default, PIXEL_RATE is read only */
+	imx378->pixel_rate = v4l2_ctrl_new_std(ctrl_hdlr, &imx378_ctrl_ops,
+					       V4L2_CID_PIXEL_RATE,
+					       imx378->pixel_rate_value,
+					       imx378->pixel_rate_value, 1,
+					       imx378->pixel_rate_value);
+	if (imx378->pixel_rate)
+		imx378->pixel_rate->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	/* LINK_FREQ is also read only */
+	imx378->link_freq =
+		v4l2_ctrl_new_int_menu(ctrl_hdlr, &imx378_ctrl_ops,
+				       V4L2_CID_LINK_FREQ, 0, 0,
+				       &imx378->link_freq_value);
+	if (imx378->link_freq)
+		imx378->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	/*
+	 * Create the controls here, but mode specific limits are setup
+	 * in the imx378_set_framing_limits() call below.
+	 */
+	imx378->vblank = v4l2_ctrl_new_std(ctrl_hdlr, &imx378_ctrl_ops,
+					   V4L2_CID_VBLANK, IMX378_VBLANK_MIN,
+					   0xffff, 1, IMX378_VBLANK_MIN);
+	imx378->hblank = v4l2_ctrl_new_std(ctrl_hdlr, &imx378_ctrl_ops,
+					   V4L2_CID_HBLANK, 0, 0xffff, 1, 0);
+
+	imx378->exposure = v4l2_ctrl_new_std(ctrl_hdlr, &imx378_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     IMX378_EXPOSURE_MIN,
+					     IMX378_EXPOSURE_MAX,
+					     IMX378_EXPOSURE_STEP,
+					     IMX378_EXPOSURE_DEFAULT);
+
+	v4l2_ctrl_new_std(ctrl_hdlr, &imx378_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  IMX378_ANA_GAIN_MIN, IMX378_ANA_GAIN_MAX,
+			  IMX378_ANA_GAIN_STEP, IMX378_ANA_GAIN_DEFAULT);
+
+	v4l2_ctrl_new_std(ctrl_hdlr, &imx378_ctrl_ops, V4L2_CID_DIGITAL_GAIN,
+			  IMX378_DGTL_GAIN_MIN, IMX378_DGTL_GAIN_MAX,
+			  IMX378_DGTL_GAIN_STEP, IMX378_DGTL_GAIN_DEFAULT);
+
+	imx378->hflip = v4l2_ctrl_new_std(ctrl_hdlr, &imx378_ctrl_ops,
+					  V4L2_CID_HFLIP, 0, 1, 1, 0);
+	if (imx378->hflip)
+		imx378->hflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	imx378->vflip = v4l2_ctrl_new_std(ctrl_hdlr, &imx378_ctrl_ops,
+					  V4L2_CID_VFLIP, 0, 1, 1, 0);
+	if (imx378->vflip)
+		imx378->vflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	v4l2_ctrl_new_std_menu_items(ctrl_hdlr, &imx378_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(imx378_test_pattern_menu) - 1,
+				     0, 0, imx378_test_pattern_menu);
+	for (i = 0; i < 4; i++) {
+		/*
+		 * The assumption is that
+		 * V4L2_CID_TEST_PATTERN_GREENR == V4L2_CID_TEST_PATTERN_RED + 1
+		 * V4L2_CID_TEST_PATTERN_BLUE   == V4L2_CID_TEST_PATTERN_RED + 2
+		 * V4L2_CID_TEST_PATTERN_GREENB == V4L2_CID_TEST_PATTERN_RED + 3
+		 */
+		v4l2_ctrl_new_std(ctrl_hdlr, &imx378_ctrl_ops,
+				  V4L2_CID_TEST_PATTERN_RED + i,
+				  IMX378_TEST_PATTERN_COLOUR_MIN,
+				  IMX378_TEST_PATTERN_COLOUR_MAX,
+				  IMX378_TEST_PATTERN_COLOUR_STEP,
+				  IMX378_TEST_PATTERN_COLOUR_MAX);
+		/* The "Solid color" pattern is white by default */
+	}
+
+	if (ctrl_hdlr->error) {
+		ret = ctrl_hdlr->error;
+		dev_err(&client->dev, "%s control init failed (%d)\n",
+			__func__, ret);
+		goto error;
+	}
+
+	ret = v4l2_fwnode_device_parse(&client->dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, &imx378_ctrl_ops,
+					      &props);
+	if (ret)
+		goto error;
+
+	imx378->sd.ctrl_handler = ctrl_hdlr;
+
+	mutex_lock(&imx378->mutex);
+
+	/* Setup exposure and frame/line length limits. */
+	imx378_set_framing_limits(imx378);
+
+	mutex_unlock(&imx378->mutex);
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(ctrl_hdlr);
+	mutex_destroy(&imx378->mutex);
+
+	return ret;
+}
+
+static void imx378_free_controls(struct imx378 *imx378)
+{
+	v4l2_ctrl_handler_free(imx378->sd.ctrl_handler);
+	mutex_destroy(&imx378->mutex);
+}
+
+static int imx378_check_link_freq(u64 link_frequency, u8 sysck_div, u16 *mpy_out)
+{
+	u64 mpy = link_frequency * 2 * sysck_div * IMX378_IOP_PREDIV;
+	u64 tmp;
+
+	do_div(mpy, IMX378_XCLK_FREQ);
+
+	tmp = mpy * (IMX378_XCLK_FREQ / IMX378_IOP_PREDIV);
+	do_div(tmp, sysck_div * 2);
+
+	if (tmp != link_frequency)
+		return -EINVAL;
+
+	if (mpy_out)
+		*mpy_out = mpy;
+
+	return 0;
+}
+
+static int imx378_check_hwcfg(struct device *dev, struct imx378 *imx378)
+{
+	struct fwnode_handle *endpoint;
+	struct v4l2_fwnode_endpoint ep_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY
+	};
+	int ret = -EINVAL;
+	int i;
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!endpoint) {
+		dev_err(dev, "endpoint node not found\n");
+		return -EINVAL;
+	}
+
+	if (v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep_cfg)) {
+		dev_err(dev, "could not parse endpoint\n");
+		goto error_out;
+	}
+
+	/* Check the number of MIPI CSI2 data lanes */
+	switch (ep_cfg.bus.mipi_csi2.num_data_lanes) {
+	case 2:
+		imx378->nlanes = 2;
+		imx378->iop_sysck_div = IMX378_IOP_SYSCK_DIV;
+		imx378->pixel_rate_value = IMX378_PIXEL_RATE;
+		break;
+	case 4:
+		imx378->nlanes = 4;
+		imx378->iop_sysck_div = IMX378_IOP_SYSCK_DIV_4LANE;
+		imx378->pixel_rate_value = IMX378_PIXEL_RATE_4LANE;
+		break;
+	default:
+		dev_err(dev, "only 2 or 4 data lanes are supported\n");
+		goto error_out;
+	}
+
+	/* Check the link frequency set in device tree */
+	if (!ep_cfg.nr_of_link_frequencies) {
+		dev_err(dev, "link-frequency property not found in DT\n");
+		goto error_out;
+	}
+
+	for (i = 0; i < ep_cfg.nr_of_link_frequencies; i++) {
+		if (!imx378_check_link_freq(ep_cfg.link_frequencies[i],
+					    imx378->iop_sysck_div,
+					    &imx378->iop_pll_mpy)) {
+			imx378->link_freq_value = ep_cfg.link_frequencies[i];
+			break;
+		}
+	}
+
+	if (i == ep_cfg.nr_of_link_frequencies) {
+		dev_err(dev, "No supported link frequency configured\n");
+			ret = -EINVAL;
+			goto error_out;
+	}
+
+	ret = 0;
+
+error_out:
+	v4l2_fwnode_endpoint_free(&ep_cfg);
+	fwnode_handle_put(endpoint);
+
+	return ret;
+}
+
+static const struct cci_reg_sequence imx378_regs[] = {
+	{CCI_REG8(0x3e35), 0x01},
+	{CCI_REG8(0x4421), 0x08},
+	{CCI_REG8(0x3ff9), 0x00},
+};
+
+static const struct imx378_compatible_data imx378_compatible = {
+	.chip_id = IMX378_CHIP_ID,
+	.extra_regs = {
+		.num_of_regs = ARRAY_SIZE(imx378_regs),
+		.regs = imx378_regs
+	}
+};
+
+static const struct of_device_id imx378_dt_ids[] = {
+	{ .compatible = "sony,imx378", .data = &imx378_compatible },
+	{ /* sentinel */ }
+};
+
+static int imx378_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct imx378 *imx378;
+	const struct of_device_id *match;
+	int ret;
+	u32 tm_of;
+
+	imx378 = devm_kzalloc(&client->dev, sizeof(*imx378), GFP_KERNEL);
+	if (!imx378)
+		return -ENOMEM;
+
+	v4l2_i2c_subdev_init(&imx378->sd, client, &imx378_subdev_ops);
+
+	imx378->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(imx378->regmap)) {
+		ret = PTR_ERR(imx378->regmap);
+		dev_err(&client->dev, "failed to initialize CCI: %d\n", ret);
+		return ret;
+	}
+
+	match = of_match_device(imx378_dt_ids, dev);
+	if (!match)
+		return -ENODEV;
+	imx378->compatible_data =
+		(const struct imx378_compatible_data *)match->data;
+
+	/* Check the hardware configuration in device tree */
+	if (imx378_check_hwcfg(dev, imx378))
+		return -EINVAL;
+
+	/* Default the trigger mode from OF to -1, which means invalid */
+	ret = of_property_read_u32(dev->of_node, "trigger-mode", &tm_of);
+	imx378->trigger_mode_of = (ret == 0) ? tm_of : -1;
+
+	/* Get system clock (xclk) */
+	imx378->xclk = devm_clk_get(dev, NULL);
+	if (IS_ERR(imx378->xclk)) {
+		dev_err(dev, "failed to get xclk\n");
+		return PTR_ERR(imx378->xclk);
+	}
+
+	imx378->xclk_freq = clk_get_rate(imx378->xclk);
+	if (imx378->xclk_freq != IMX378_XCLK_FREQ) {
+		dev_err(dev, "xclk frequency not supported: %d Hz\n",
+			imx378->xclk_freq);
+		return -EINVAL;
+	}
+
+	ret = imx378_get_regulators(imx378);
+	if (ret) {
+		dev_err(dev, "failed to get regulators\n");
+		return ret;
+	}
+
+	/* Request optional enable pin */
+	imx378->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+
+	/*
+	 * The sensor must be powered for imx378_identify_module()
+	 * to be able to read the CHIP_ID register
+	 */
+	ret = imx378_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = imx378_identify_module(imx378, imx378->compatible_data->chip_id);
+	if (ret)
+		goto error_power_off;
+
+	/* Initialize default format */
+	imx378_set_default_format(imx378);
+
+	/*
+	 * Enable runtime PM with 5s autosuspend. As the device has been powered
+	 * manually, mark it as active, and increase the usage count without
+	 * resuming the device.
+	 */
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_set_autosuspend_delay(dev, 5000);
+	pm_runtime_use_autosuspend(dev);
+
+	/* This needs the pm runtime to be registered. */
+	ret = imx378_init_controls(imx378);
+	if (ret)
+		goto error_power_off;
+
+	/* Initialize subdev */
+	imx378->sd.internal_ops = &imx378_internal_ops;
+	imx378->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE |
+			    V4L2_SUBDEV_FL_HAS_EVENTS;
+	imx378->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+
+	/* Initialize source pads */
+	imx378->pad[IMAGE_PAD].flags = MEDIA_PAD_FL_SOURCE;
+	imx378->pad[METADATA_PAD].flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&imx378->sd.entity, NUM_PADS, imx378->pad);
+	if (ret) {
+		dev_err(dev, "failed to init entity pads: %d\n", ret);
+		goto error_handler_free;
+	}
+
+	ret = v4l2_async_register_subdev_sensor(&imx378->sd);
+	if (ret < 0) {
+		dev_err(dev, "failed to register sensor sub-device: %d\n", ret);
+		goto error_media_entity;
+	}
+
+	pm_runtime_mark_last_busy(&client->dev);
+	pm_runtime_put_autosuspend(&client->dev);
+
+	return 0;
+
+error_media_entity:
+	media_entity_cleanup(&imx378->sd.entity);
+
+error_handler_free:
+	imx378_free_controls(imx378);
+
+error_power_off:
+	pm_runtime_disable(&client->dev);
+	pm_runtime_put_noidle(&client->dev);
+	imx378_power_off(&client->dev);
+
+	return ret;
+}
+
+static void imx378_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx378 *imx378 = to_imx378(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	imx378_free_controls(imx378);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		imx378_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+MODULE_DEVICE_TABLE(of, imx378_dt_ids);
+
+static const struct dev_pm_ops imx378_pm_ops = {
+	SET_SYSTEM_SLEEP_PM_OPS(imx378_suspend, imx378_resume)
+	SET_RUNTIME_PM_OPS(imx378_power_off, imx378_power_on, NULL)
+};
+
+static struct i2c_driver imx378_i2c_driver = {
+	.driver = {
+		.name = "imx378",
+		.of_match_table	= imx378_dt_ids,
+		.pm = &imx378_pm_ops,
+	},
+	.probe = imx378_probe,
+	.remove = imx378_remove,
+};
+
+module_i2c_driver(imx378_i2c_driver);
+
+MODULE_AUTHOR("Naushir Patuck <naush@raspberrypi.com>");
+MODULE_DESCRIPTION("Sony IMX378 sensor driver");
+MODULE_LICENSE("GPL v2");
