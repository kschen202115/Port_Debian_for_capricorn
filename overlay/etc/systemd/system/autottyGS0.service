[Unit]
Description=Auto-login console on USB serial (ttyGS0)
After=multi-user.target

[Service]
Type=simple
ExecStart=/home/auto_ttyGS0.sh kschen
Restart=always
RestartSec=5
# 不用 StandardInput=tty + TTYPath：设备在启动早期还不存在，
# systemd 会 open 失败导致无意义的重启循环。改由脚本自己等待并打开。
StandardInput=null
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
