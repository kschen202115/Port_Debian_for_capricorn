[Unit]
Description=Grow root filesystem to fill its partition
Documentation=man:resize2fs(8)
# 只在根已经可写时才有意义
ConditionPathIsReadWrite=/
After=systemd-remount-fs.service
ConditionPathExists=/usr/local/sbin/grow-rootfs

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/grow-rootfs
StandardOutput=journal
StandardError=journal

[Install]
# 刻意挂在 multi-user.target 而不是 local-fs.target：ext4 在线扩容什么时候做
# 都可以，而挂 local-fs.target 的服务带默认依赖时容易和 sysinit 形成排序环。
WantedBy=multi-user.target
